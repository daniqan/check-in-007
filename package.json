{
  "name": "check-in-007",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "serve": "http-server . -p 8080 -c-1",
    "serve:https": "http-server . -S -C localhost.pem -K localhost-key.pem -p 8443 -c-1",
    "check:node": "node scripts/check-node-version.mjs",
    "build": "node scripts/check-node-version.mjs && node scripts/build.mjs",
    "lint": "node scripts/check-node-version.mjs && prettier --check .",
    "test": "node scripts/check-node-version.mjs && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "fonts:subset": "bash scripts/font-subset.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "acorn": "8.18.0",
    "axe-core": "4.13.0",
    "http-server": "14.1.1",
    "prettier": "3.9.6"
  }
}
